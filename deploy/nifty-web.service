[Unit]
Description=NIFTY private research web dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/nifty-layer2-engine
EnvironmentFile=/home/ubuntu/.config/nifty-layer2/web.env
ExecStart=/home/ubuntu/nifty-layer2-engine/.venv/bin/python -m nifty_l2.web
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.config/nifty-layer2

[Install]
WantedBy=multi-user.target
