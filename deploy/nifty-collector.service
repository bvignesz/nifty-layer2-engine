[Unit]
Description=NIFTY market-session research collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/nifty-layer2-engine
ExecStart=/home/ubuntu/nifty-layer2-engine/.venv/bin/python -m nifty_l2.collector
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.config/nifty-layer2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
