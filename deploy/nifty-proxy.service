[Unit]
Description=NIFTY HTTPS proxy with automatic IP certificate renewal
After=network-online.target nifty-web.service
Wants=network-online.target

[Service]
Type=notify
User=www-data
Group=www-data
Environment=HOME=/var/lib/nifty-proxy
ExecStart=/usr/local/bin/nifty-caddy run --config /etc/nifty-proxy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=nifty-proxy
StateDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
