[Unit]
Description=Refresh official RBI and PIB premarket headlines for NIFTY research
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/nifty-platform-validation
Environment=PYTHONPATH=/home/ubuntu/nifty-platform-validation
ExecStart=/home/ubuntu/nifty-layer2-engine/.venv/bin/python -m nifty_l2.premarket_news --directory /home/ubuntu/.config/nifty-layer2/web-runtime
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.config/nifty-layer2/web-runtime
UMask=0077
